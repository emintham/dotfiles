# Global gitignore file
# OS-specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Editor files
*~
*.swp
*.swo
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Build artifacts and dependencies
node_modules/
target/
dist/
build/
*.o
*.so
*.dylib
*.dll
*.exe

# Environment and secrets
.env
.env.local
.env.*.local
*.pem
*.key
*.cert

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
*.tmp
*.temp
.cache/
